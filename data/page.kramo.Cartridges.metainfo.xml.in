<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Gamerdeck</name>
  <summary>Launch all your games</summary>
  <description>
    <p>Gamerdeck is a simple game launcher for all of your games. It has support for importing games from Steam, Lutris, Heroic and more with no login necessary. You can sort and hide games or download cover art from SteamGridDB.</p>
  </description>
  <url type="homepage">https://github.com/jeffersonmk/gamerdeck</url>
  <url type="bugtracker">https://github.com/jeffersonmk/gamerdeck/issues</url>
  <url type="vcs-browser">https://github.com/jeffersonmk/gamerdeck</url>
  <url type="contribute">https://github.com/jeffersonmk/gamerdeck/blob/main/CONTRIBUTING.md</url>
  <developer id="io.github.jeffersonmk">
    <name translate="no">jeffersonmk</name>
  </developer>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <translation type="gettext">cartridges</translation>
  <branding>
    <color type="primary" scheme_preference="light">#b5d6f6</color>
    <color type="primary" scheme_preference="dark">#1f3f66</color>
  </branding>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jeffersonmk/gamerdeck/main/data/screenshots/1.png</image>
      <caption>The library, with the banner of the game in focus, the games played last and the controller legend</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jeffersonmk/gamerdeck/main/data/screenshots/2.png</image>
      <caption>A game page, with the ProtonDB rating and the app it came from</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jeffersonmk/gamerdeck/main/data/screenshots/3.png</image>
      <caption>The sources, in light mode, with PlayStation symbols</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/jeffersonmk/gamerdeck/main/data/screenshots/4.png</image>
      <caption>Preferences: controller hints and ProtonDB</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="1.1.2" date="2026-11-02">
      <description translate="no">
        <ul>
          <li>New single-color console icons on the cover of emulator games: brand logos for PlayStation, Sega and Xbox, console drawings for Nintendo</li>
          <li>Icons for Wii U, Switch, Xbox and 3DS, which had none</li>
        </ul>
      </description>
    </release>
    <release version="1.1.1" date="2026-11-02">
      <description translate="no">
        <ul>
          <li>Update Gamerdeck from the app (Preferences, General, Updates) or with scripts/update.sh</li>
          <li>Fixed the preferences not opening after an update of the source installation</li>
          <li>Games imported before emulators were recognized get their console icon on the next import</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-11-02">
      <description translate="no">
        <ul>
          <li>Games started through an emulator (PCSX2, Dolphin, PPSSPP, mGBA and others) show the icon of their console on the cover</li>
          <li>A preference to show or hide the Continue Playing row</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-01">
      <description translate="no">
        <p>The first release of Gamerdeck, a game launcher for Linux.</p>
        <ul>
          <li>Navigate the whole app with an Xbox or PlayStation controller, with a legend of what each button does that shows while you use the controller</li>
          <li>A banner with the game in focus and a row with the games you played last</li>
          <li>A virtualized library that stays fast with thousands of games</li>
          <li>New sources: Faugus and Lutris</li>
          <li>Platform badges on the covers, and an option to show only games (no tools or runtimes)</li>
          <li>ProtonDB ratings on the covers and on the game page</li>
          <li>Follows the accent color of the system</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
